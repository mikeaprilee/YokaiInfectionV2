<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/transitionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yokai_background"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/portada"
        android:scaleType="centerCrop"
        android:alpha="0.68"
        android:contentDescription="Luna roja de Yokai Infection" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="妖 怪"
            android:textColor="#E53935"
            android:textSize="38sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="YOKAI INFECTION"
            android:textColor="@color/yokai_text_primary"
            android:textSize="25sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:fontFamily="monospace"
            android:gravity="center" />

        <View
            android:layout_width="180dp"
            android:layout_height="2dp"
            android:layout_marginTop="24dp"
            android:background="@color/yokai_red" />

        <TextView
            android:id="@+id/txtTransitionWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="LA LUNA ROJA DESPIERTA"
            android:textColor="@color/yokai_text_primary"
            android:textSize="14sp"
            android:letterSpacing="0.08"
            android:fontFamily="monospace" />

    </LinearLayout>

</FrameLayout>
