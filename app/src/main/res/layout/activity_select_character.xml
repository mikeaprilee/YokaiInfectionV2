
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yokai_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="妖 怪"
            android:textColor="@color/yokai_red_title"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="YOKAI INFECTION"
            android:textColor="@color/yokai_text_primary"
            android:textSize="25sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:fontFamily="monospace" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="@color/yokai_red" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECCIONA TU YOKAI"
            android:textColor="@color/yokai_text_light"
            android:textSize="14sp"
            android:letterSpacing="0.12"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerYokai"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:text="ELIGE CON CUIDADO"
            android:textColor="@color/yokai_text_gray"
            android:textSize="11sp"
            android:letterSpacing="0.10"
            android:fontFamily="monospace" />

    </LinearLayout>
</LinearLayout>
