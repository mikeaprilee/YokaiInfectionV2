<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="¿COMENZAR PARTIDA?"
        android:textColor="@color/yokai_red_title"
        android:textSize="19sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imgDialogCharacter"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/txtDialogCharacterName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="@color/yokai_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtDialogCharacterMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="¿Estás seguro de que quieres jugar con este personaje?"
        android:textColor="@color/yokai_text_lore"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogCancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:fontFamily="monospace"
            android:text="CANCELAR"
            android:textColor="@color/yokai_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#222222" />

        <Button
            android:id="@+id/btnDialogPlay"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:text="JUGAR"
            android:textColor="@color/yokai_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/yokai_red_dark" />

    </LinearLayout>

</LinearLayout>